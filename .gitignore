# Allowlist: everything is ignored unless listed below.
*
!*/
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/install.ps1
!/install.sh
!/office-read/**
!/office-edit/**
!/tests/**

# Re-deny inside allowed paths
__pycache__/
*.pyc
*.bak
.env
*.env
*secret*.json
*secret*.toml
*secret*.yaml
*secret*.yml
*secret*.txt
*credential*.json
*credential*.toml
*credential*.yaml
*credential*.yml
*credential*.txt
*.pem
*.key
id_rsa*
*password*.txt
*password*.json
*password*.toml
*password*.yaml
*password*.yml
*pws*.txt
pwlist*.txt

# Office documents and data never belong in the repository: the tests build their own
# fixtures in a temporary folder, so any such file here is a real one put down to try
*.xlsx
*.xlsm
*.xltx
*.xltm
*.xls
*.docx
*.docm
*.dotx
*.doc
*.pptx
*.pptm
*.potx
*.ppt
*.pdf
*.msg
*.eml
*.zip
*.7z
*.mpp
*.mpt
*.xml
*.csv
*.tsv
*.vsdx
*.drawio
*.png
*.jpg
*.jpeg

# Organisation-specific profiles stay local; only the README and template are published.
/office-read/profiles/*.md
!/office-read/profiles/README.md
!/office-read/profiles/_template.md
